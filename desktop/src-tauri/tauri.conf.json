{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivo",
  "version": "0.1.0",
  "identifier": "app.homecinema.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rivo",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#141A33"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/homecinema-server", "binaries/ffmpeg", "binaries/ffprobe"],
    "shortDescription": "Домашний медиасервер",
    "longDescription": "Библиотека фильмов и сериалов, плеер, трансляция на ТВ и встроенный торрент-клиент.",
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    }
  }
}
